{
  "version": 8,
  "name": "Bus Timer Transit Light",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "paper",
      "type": "background",
      "paint": {
        "background-color": "#F8FAFC"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "park",
        "grass",
        "cemetery",
        "wood",
        "forest"
      ],
      "paint": {
        "fill-color": "#E4F3E7"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "wood",
        "grass"
      ],
      "paint": {
        "fill-color": "#EFF6EE",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#CDE9F9"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#E5E9EF",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.45,
          16,
          0.85
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary",
        "minor",
        "service",
        "residential"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D7DDE5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.4,
          13,
          4,
          16,
          13,
          18,
          25
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary",
        "minor",
        "service",
        "residential"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.8,
          13,
          3,
          16,
          11,
          18,
          23
        ]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "in",
        "class",
        "path",
        "footway",
        "pedestrian"
      ],
      "paint": {
        "line-color": "#DFE4EA",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          17,
          2
        ]
      }
    },
    {
      "id": "major-place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          10,
          14,
          13
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#526276",
        "text-halo-color": "#F8FAFC",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#7B8796",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.1
      }
    }
  ]
}
