{
  "version": 8,
  "name": "Bus Timer Bright Transit",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "paper",
      "type": "background",
      "paint": {
        "background-color": "#F8FAFC"
      }
    },
    {
      "id": "natural-landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "wood",
        "grass"
      ],
      "paint": {
        "fill-color": "#E9F4EB",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "park",
        "grass",
        "cemetery",
        "wood",
        "forest"
      ],
      "paint": {
        "fill-color": "#DDF0DF",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#BDE8F8"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E7EDF2",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.4,
          15,
          0.72,
          17,
          0.88
        ]
      }
    },
    {
      "id": "local-roads-border",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "in",
        "class",
        "minor",
        "residential",
        "service"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D5DFE9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.5,
          14,
          3,
          17,
          11
        ]
      }
    },
    {
      "id": "local-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "in",
        "class",
        "minor",
        "residential",
        "service"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.3,
          14,
          1.9,
          17,
          9.5
        ]
      }
    },
    {
      "id": "major-roads-border",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#F3D17A",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.2,
          14,
          6.8,
          17,
          19
        ]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFF7E6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          14,
          5.4,
          17,
          17.4
        ]
      }
    },
    {
      "id": "pedestrian-paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "in",
        "class",
        "path",
        "footway",
        "pedestrian"
      ],
      "paint": {
        "line-color": "#DBE6E9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0.6,
          17,
          1.8
        ]
      }
    },
    {
      "id": "major-place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          10,
          14,
          12
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#50627B",
        "text-halo-color": "#F8FAFC",
        "text-halo-width": 1.3,
        "text-opacity": 0.86
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 16,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ko"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#8A9AA8",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.1
      }
    }
  ]
}
