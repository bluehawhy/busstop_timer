      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        "class",
        "wood",
        "grass"
      ],
      "paint": {
        "fill-color": "#E2F1E3",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "park-greenery",
      "type": "fill",
      "source": "openmaptiles",
