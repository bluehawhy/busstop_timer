ALLOWED_ORIGINS=https://bustimer.bluewaikiki.top
# Generate each secret separately with: openssl rand -hex 32
# Use hexadecimal DB passwords here so DATABASE_URL requires no URL encoding.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX_ADMIN_PASSWORD
BUS_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_APP_PASSWORD
# Administrator token for catalogue imports. Never ship to the app.
API_BEARER_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
# Optional legacy arrivals provider; normalized catalogue imports are separate.
BUS_ARRIVALS_URL=
BUS_API_KEY=

# Arrival collection: auto, normalized, tago, or busan. TAGO needs approved arrival API access.
BUS_PROVIDER=normalized
# Encoded or decoded data.go.kr key. Server only.
# Legacy common key fallback (optional).
TAGO_SERVICE_KEY=
# Separate approved service keys take priority over the common key.
TAGO_STATION_SERVICE_KEY=
TAGO_ARRIVAL_SERVICE_KEY=
BUS_PROVIDER_DAILY_LIMIT=9000
# One cycle per minute, up to 5 distinct saved stops (round-robin).
BUS_COLLECTION_BATCH_SIZE=5

# Busan BIMS: encoded or decoded portal key, server only.
BUSAN_SERVICE_KEY=

# BUS_PROVIDER=auto enables mixed Busan/TAGO collection per saved stop.
# TAGO requires approvals for BOTH station and arrival services.

# Email link/OTP: same SMTP setting names as household_ledger (independent accounts).
AUTH_SMTP_HOST=smtp.resend.com
AUTH_SMTP_PORT=465
AUTH_SMTP_TLS_MODE=ssl
AUTH_SMTP_USERNAME=resend
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=버스타이머 <noreply@bluewaikiki.top>
# Generate independently from the ledger: openssl rand -hex 32
AUTH_RATE_LIMIT_KEY=
AUTH_SESSION_HOURS=6
# Enable only behind a trusted proxy which overwrites X-Forwarded-For.
AUTH_TRUST_PROXY=false

MAIL_AUTH_MODE=link
AUTH_EMAIL_LINK_URL=https://bustimer.bluewaikiki.top/api/auth/verify
